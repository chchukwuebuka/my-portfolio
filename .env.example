# =============================================================================
# Private Portfolio Analytics Dashboard — Server-Side Environment Variables
# Copy to .env for local testing with `netlify dev`.
# NEVER commit .env or any real secret values to Git.
# Configure these exact keys in Netlify: Site configuration -> Environment variables
# =============================================================================

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://chukwuebuka-eg-portfolio.netlify.app/.netlify/functions/auth-callback
ADMIN_EMAIL=your-authorized-google-email@gmail.com

# Google Analytics 4 Property ID (numeric Property ID — NOT Stream ID or G- Measurement ID)
GA4_PROPERTY_ID=565407830
GA4_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-64-random-hex-characters
